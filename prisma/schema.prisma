  taxonomy_terms            taxonomy_terms?        @relation(fields: [taxonomy_term_id], references: [id], onUpdate: NoAction)

  @@index([taxonomy_term_id], map: "idx_sessions_taxonomy_term_id")
  @@index([end_time], map: "ix_session_sessions_end_time")
  @@index([id], map: "ix_session_sessions_id")
  @@index([session_profile_id], map: "ix_session_sessions_session_profile_id")
  @@index([start_time], map: "ix_session_sessions_start_time")
  @@index([status], map: "ix_session_sessions_status")
  @@schema("session")
}

model tax_profiles {
  id             Int              @id @default(autoincrement())
  txuid          String           @unique(map: "ix_tax_tax_profiles_txuid") @db.VarChar(50)
  name           String           @db.VarChar(100)
  description    String?          @db.VarChar(255)
  created_by     Int
  is_active      Boolean?
  is_deleted     Boolean
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  products       products[]
  services       services[]
  order_items    order_items[]
  order_services order_services[]
  backendusers   backendusers     @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tax_rates      tax_rates[]

  @@index([id], map: "ix_tax_tax_profiles_id")
  @@index([is_deleted], map: "ix_tax_tax_profiles_is_deleted")
  @@schema("tax")
}

model tax_rate_locations {
  id            Int       @id @default(autoincrement())
  luid          String    @unique(map: "ix_tax_tax_rate_locations_luid") @db.VarChar(50)
  tax_rate_id   Int
  location_type String    @db.VarChar(20)
  location_code String    @db.VarChar(50)
  is_deleted    Boolean
  tax_rates     tax_rates @relation(fields: [tax_rate_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "ix_tax_tax_rate_locations_id")
  @@index([is_deleted], map: "ix_tax_tax_rate_locations_is_deleted")
  @@index([location_code], map: "ix_tax_tax_rate_locations_location_code")
  @@index([tax_rate_id], map: "ix_tax_tax_rate_locations_tax_rate_id")
  @@schema("tax")
}

model tax_rates {
  id                 Int                  @id @default(autoincrement())
  truid              String               @unique(map: "ix_tax_tax_rates_truid") @db.VarChar(50)
  rate               Float
  calculation_type   String               @db.VarChar(20)
  name               String               @db.VarChar(100)
  priority           Int
  is_deleted         Boolean
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  tax_profile_id     Int
  tax_rate_locations tax_rate_locations[]
  tax_profiles       tax_profiles         @relation(fields: [tax_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "ix_tax_tax_rates_id")
  @@index([is_deleted], map: "ix_tax_tax_rates_is_deleted")
  @@index([name], map: "ix_tax_tax_rates_name")
  @@index([tax_profile_id], map: "ix_tax_tax_rates_tax_profile_id")
  @@schema("tax")
}
